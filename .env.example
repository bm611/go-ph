# go-ph Configuration Example
# Copy this file to .env and fill in your API keys

# Required API Keys
GEMINI_API_KEY=your-gemini-api-key-here
JINA_API_KEY=your-jina-api-key-here

# Optional Configuration (defaults shown)
PRODUCT_HUNT_URL=https://producthunt.com
JINA_BASE_URL=https://r.jina.ai/
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
MAX_PRODUCTS=10
RESPONSE_MIME_TYPE=application/json

# Custom Extraction Prompt (optional)
# If you want to customize the AI prompt, you can set this variable
# The prompt should contain two %d and %s placeholders for max_products and content
# EXTRACTION_PROMPT="your custom prompt here with %d products and %s content"

# How to get API Keys:
#
# Gemini API Key:
# 1. Visit https://aistudio.google.com/app/apikey
# 2. Create a new API key
# 3. Copy the key and paste it above
#
# Jina AI API Key:
# 1. Visit https://jina.ai/ and sign up
# 2. Go to your dashboard and create an API key
# 3. Copy the key and paste it above
